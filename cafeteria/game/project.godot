; Engine configuration file.
; Cafeteria Coup — Chapter 1: The Sunspire. Godot 4.7+.

config_version=5

[application]

config/name="Cafeteria Coup"
config/description="A proactive stealth-heist about stealing an Archmage's useless relic to fix the cafeteria."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
